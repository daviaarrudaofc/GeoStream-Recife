.env.example

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# Data Configuration
CSV_PATH=data/dados_recife.csv
CSV_SEPARATOR=;

# Geographic Configuration
H3_RESOLUTION=8
RECIFE_LAT=-8.05
RECIFE_LON=-34.90

# Optional: Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# Database
DATABASE_URL=sqlite:///./geostream.db
